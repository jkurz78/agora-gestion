APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Coordonnées MySQL utilisées uniquement par phpunit.mysql.xml, qui force
# DB_CONNECTION=mysql et DB_DATABASE=testing. Elles sont sans effet sur la suite
# par défaut ci-dessus, qui reste sur SQLite.
#
# Valeurs de Sail. En CI, le workflow les surcharge par des variables
# d'environnement réelles (127.0.0.1 / root) — Laravel ne réécrit jamais une
# variable déjà présente dans l'environnement, donc la surcharge l'emporte.
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=sail
DB_PASSWORD=password

BCRYPT_ROUNDS=4

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
